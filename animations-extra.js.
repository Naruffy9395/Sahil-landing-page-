/* Sahil Portfolio — Extra Premium Animations (add-on, works with existing animations.js) */
(function () {
  "use strict";

  const css2 = `
    html{scroll-behavior:smooth}

    body::before{content:'';position:fixed;inset:0;z-index:-1;pointer-events:none;
      background-image:radial-gradient(rgba(255,255,255,.035) 1px,transparent 1px);
      background-size:34px 34px;opacity:.5;will-change:transform}

    .timeline-dot,.step-dot,[data-timeline] .dot,.journey-dot{
      transition:box-shadow .5s ease,transform .5s ease,background .5s ease}
    .timeline-dot.tl-active,.step-dot.tl-active,[data-timeline].tl-active .dot,.journey-dot.tl-active{
      box-shadow:0 0 18px 4px rgba(255,180,60,.55);transform:scale(1.15)}

    .tl-line-fill{position:absolute;top:0;left:0;width:100%;height:0;
      background:linear-gradient(180deg,#ffb43c,#ff8a3c);transition:height .6s cubic-bezier(.2,.8,.2,1)}

    section,[data-fade-up]{opacity:0;transform:translateY(28px);
      transition:opacity .8s cubic-bezier(.2,.8,.2,1),transform .8s cubic-bezier(.2,.8,.2,1)}
    section.fu-in,[data-fade-up].fu-in{opacity:1;transform:translateY(0)}

    .card,.project-card,.skill-card,.timeline-item,.journey-item{
      transition:transform .4s cubic-bezier(.2,.8,.2,1),box-shadow .4s ease,border-color .4s ease}
    .card:hover,.project-card:hover,.skill-card:hover,.timeline-item:hover,.journey-item:hover{
      transform:translateY(-6px);box-shadow:0 20px 40px -20px rgba(0,0,0,.5)}

    a,button,.btn{position:relative;overflow:hidden}
    .ripple{position:absolute;border-radius:50%;background:rgba(255,255,255,.35);
      transform:scale(0);animation:rippleAnim .6s ease-out forwards;pointer-events:none}
    @keyframes rippleAnim{to{transform:scale(3);opacity:0}}

    nav a.nav-active{color:#ffb43c!important}
  `;
  const s2 = document.createElement("style");
  s2.textContent = css2;
  document.head.appendChild(s2);

  /* 1. Generic fade-up for any section or [data-fade-up] element */
  const fadeTargets = document.querySelectorAll("section, [data-fade-up]");
  const fadeObserver = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) {
        e.target.classList.add("fu-in");
        fadeObserver.unobserve(e.target);
      }
    });
  }, { threshold: 0.15 });
  fadeTargets.forEach((el) => fadeObserver.observe(el));

  /* 2. Timeline dot glow-in as you scroll (Journey section) */
  const timelineDots = document.querySelectorAll(
    ".timeline-dot, .step-dot, [data-timeline] .dot, .journey-dot"
  );
  const dotObserver = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) {
        e.target.classList.add("tl-active");
        dotObserver.unobserve(e.target);
      }
    });
  }, { threshold: 0.6 });
  timelineDots.forEach((el) => dotObserver.observe(el));
