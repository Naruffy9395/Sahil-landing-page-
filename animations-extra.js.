/* Sahil Portfolio — Premium Extra Animations v3 */
(function () {
  "use strict";

  const css = `
    html{scroll-behavior:smooth}

    body::before{content:'';position:fixed;inset:0;z-index:-1;pointer-events:none;
      background-image:radial-gradient(rgba(255,255,255,.03) 1px,transparent 1px);
      background-size:36px 36px;opacity:.55}

    /* Section-wide fade + rise */
    section{opacity:0;transform:translateY(40px);
      transition:opacity 1s cubic-bezier(.16,1,.3,1),transform 1s cubic-bezier(.16,1,.3,1)}
    section.sec-in{opacity:1;transform:translateY(0)}

    /* Stagger children inside a section once it's in */
    .reveal{opacity:0;transform:translateY(24px);
      transition:opacity .8s cubic-bezier(.16,1,.3,1),transform .8s cubic-bezier(.16,1,.3,1)}
    section.sec-in .reveal{opacity:1;transform:translateY(0)}

    /* Project + skill cards: tilt-lift on hover, staggered entrance */
    .project-card,.skill-chip,.stat{
      transition:transform .5s cubic-bezier(.16,1,.3,1),box-shadow .5s ease,border-color .4s ease}
    .project-card:hover{transform:translateY(-8px) scale(1.015);
      box-shadow:0 30px 60px -28px rgba(0,0,0,.65);border-color:#3a3f52}
    .skill-chip:hover{transform:translateY(-5px)}
    .stat:hover{transform:translateY(-4px);border-color:var(--amber)}

    /* Image reveal wipe */
    .about-img img,.project-img img{clip-path:polygon(0 0,0 0,0 100%,0 100%);
      transition:clip-path 1.1s cubic-bezier(.16,1,.3,1)}
    .about-img.img-in img,.project-img.img-in img{clip-path:polygon(0 0,100% 0,100% 100%,0 100%)}

    /* Timeline glow-dots */
    .tl-item::before{transition:box-shadow .6s ease,transform .6s ease,border-color .6s ease}
    .tl-item.tl-active::before{border-color:var(--teal)!important;
      box-shadow:0 0 18px 4px rgba(51,201,176,.6);transform:scale(1.3)}
    .tl-item h3,.tl-item p{transition:opacity .6s ease,transform .6s ease}

    /* Stat counter pop */
    .stat .n{display:inline-block}

    /* Nav active + scrolled state */
    nav{transition:background .4s ease,border-color .4s ease,box-shadow .4s ease}
    nav.nav-scrolled{box-shadow:0 8px 24px -12px rgba(0,0,0,.5)}
    .nav-links a{position:relative;transition:color .3s ease}
    .nav-links a::after{content:'';position:absolute;left:0;bottom:-4px;width:0;height:1.5px;
      background:var(--amber);transition:width .3s cubic-bezier(.16,1,.3,1)}
    .nav-links a.nav-active{color:var(--text)!important}
    .nav-links a.nav-active::after{width:100%}

    /* Buttons: ripple + magnetic feel */
    .btn,.contact-line{position:relative;overflow:hidden}
    .ripple{position:absolute;border-radius:50%;background:rgba(255,255,255,.35);
      transform:scale(0);animation:rippleAnim .65s ease-out forwards;pointer-events:none}
    @keyframes rippleAnim{to{transform:scale(3);opacity:0}}

    /* Custom cursor (desktop only) */
    #cx-dot,#cx-ring{position:fixed;top:0;left:0;pointer-events:none;z-index:9999;
      border-radius:50%;transform:translate(-50%,-50%);
      transition:opacity .3s,width .25s,height .25s,border-color .25s,background .25s}
    #cx-dot{width:6px;height:6px;background:var(--amber);opacity:0}
    #cx-ring{width:36px;height:36px;border:1px solid rgba(237,238,242,.3);opacity:0}
    body.cx-on #cx-dot,body.cx-on #cx-ring{opacity:1}
    body.cx-hover #cx-ring{width:56px;height:56px;border-color:var(--amber);background:rgba(242,169,60,.08)}
    body.cx-hover #cx-dot{opacity:0}
    @media(hover:none),(pointer:coarse){#cx-dot,#cx-ring{display:none!important}}
  `;
  const styleTag = document.createElement("style");
  styleTag.textContent = css;
  document.head.appendChild(styleTag);

  /* 1. Section-level reveal with staggered children */
  const sections = document.querySelectorAll("section");
  const secObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const kids = entry.target.querySelectorAll(".reveal");
        kids.forEach((el, i) => {
          el.style.transitionDelay = (i * 0.08) + "s";
        });
        entry.target.classList.add("sec-in");
        secObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15 });
  sections.forEach((el) => secObserver.observe(el));

  /* 2. Image wipe reveal */
  const imgWraps = document.querySelectorAll(".about-img, .project-img");
  const imgObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add("img-in");
        imgObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.25 });
  imgWraps.forEach((el) => imgObserver.observe(el));

  /* 3. Timeline dot glow */
  const tlItems = document.querySelectorAll(".tl-item");
  const tlObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add("tl-active");
        tlObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.5 });
  tlItems.forEach((el) => tlObserver.observe(el));
/* 4. Animated stat counters (50+, 20+, 100%) */
  const stats = document.querySelectorAll(".stat .n");
  const statObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      const el = entry.target;
      const raw = el.textContent.trim();
      const match = raw.match(/(\d+)/);
      if (!match) { statObserver.unobserve(el); return; }
      const target = parseInt(match[1], 10);
      const suffix = raw.replace(match[1], "");
      const start = performance.now();
      const dur = 1400;
      (function step(now) {
        const p = Math.min(1, (now - start) / dur);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = Math.floor(eased * target) + suffix;
        if (p < 1) requestAnimationFrame(step);
      })(performance.now());
      statObserver.unobserve(el);
    });
  }, { threshold: 0.6 });
  stats.forEach((el) => statObserver.observe(el));

  /* 5. Nav: scrolled background + active link tracking */
  const nav = document.querySelector("nav");
  const navLinks = document.querySelectorAll(".nav-links a[href^='#']");
  const navSections = Array.from(navLinks)
    .map((a) => document.querySelector(a.getAttribute("href")))
    .filter(Boolean);

  function updateNav() {
    if (nav) nav.classList.toggle("nav-scrolled", window.scrollY > 40);
    let current = null;
    navSections.forEach((sec) => {
      const rect = sec.getBoundingClientRect();
      if (rect.top <= 130 && rect.bottom >= 130) current = sec;
    });
    navLinks.forEach((a) => {
      const match = current && a.getAttribute("href") === "#" + current.id;
      a.classList.toggle("nav-active", !!match);
    });
  }
  addEventListener("scroll", updateNav, { passive: true });
  updateNav();

  /* 6. Ripple on buttons + contact links */
  document.addEventListener("click", function (e) {
    const target = e.target.closest(".btn, .contact-line");
    if (!target) return;
    const rect = target.getBoundingClientRect();
    const ripple = document.createElement("span");
    ripple.className = "ripple";
    const size = Math.max(rect.width, rect.height);
    ripple.style.width = ripple.style.height = size + "px";
    ripple.style.left = (e.clientX - rect.left - size / 2) + "px";
    ripple.style.top = (e.clientY - rect.top - size / 2) + "px";
    target.appendChild(ripple);
    setTimeout(() => ripple.remove(), 650);
  });

  /* 7. Custom cursor + magnetic buttons (desktop only) */
  if (matchMedia("(hover:hover) and (pointer:fine)").matches) {
    const dot = document.createElement("div"); dot.id = "cx-dot";
    const ring = document.createElement("div"); ring.id = "cx-ring";
    document.body.append(dot, ring);
    let mx = 0, my = 0, rx = 0, ry = 0;

    addEventListener("mousemove", (e) => {
      mx = e.clientX; my = e.clientY;
      dot.style.transform = `translate(${mx}px,${my}px) translate(-50%,-50%)`;
      document.body.classList.add("cx-on");
    });
    addEventListener("mouseleave", () => document.body.classList.remove("cx-on"));

    (function loop() {
      rx += (mx - rx) * 0.18;
      ry += (my - ry) * 0.18;
      ring.style.transform = `translate(${rx}px,${ry}px) translate(-50%,-50%)`;
      requestAnimationFrame(loop);
    })();

    document.querySelectorAll("a, button, .btn, .project-card, .skill-chip, .contact-line")
      .forEach((el) => {
        el.addEventListener("mouseenter", () => document.body.classList.add("cx-hover"));
        el.addEventListener("mouseleave", () => document.body.classList.remove("cx-hover"));
      });

    document.querySelectorAll(".btn").forEach((btn) => {
      btn.addEventListener("mousemove", (e) => {
        const r = btn.getBoundingClientRect();
        btn.style.transform =
          `translate(${(e.clientX - r.left - r.width / 2) * 0.2}px, ${(e.clientY - r.top - r.height / 2) * 0.3}px)`;
      });
      btn.addEventListener("mouseleave", () => { btn.style.transform = "translate(0,0)"; });
    });
  }
})();
